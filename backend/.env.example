# AI Provider: groq or gemini
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Enable after turning on Zero Data Retention at:
# https://console.groq.com/settings/data-controls
GROQ_ZDR_ENABLED=true

# Archive limits (optional overrides)
# MAX_ZIP_UPLOAD_SIZE_MB=200
# ZIP_MAX_FILES_TO_ANALYZE=150
