# Backend Environment Configuration Example

# Django Core
SECRET_KEY=your-super-secret-random-key
DEBUG=False
ALLOWED_HOSTS=*

# Supabase PostgreSQL Database URL
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/uiux_feedback

# AI Analysis Keys
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security & CORS
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:5173
